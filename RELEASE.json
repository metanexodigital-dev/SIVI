{
  "application": "SIVI",
  "version": "Pre-1.0.0.3",
  "stage": "preproduction",
  "production_baseline": "1.0.0.0",
  "required_environment_variable": "APP_VERSION=Pre-1.0.0.3",
  "release_date": "2026-08-06",
  "status": "preproduction",
  "name": "Preproducción Pre-1.0.0.3 - documentación dinámica de versión",
  "build_id": "SIVI-Pre-1.0.0.3",
  "release_notes": "Corrige el control readme_general_documentation para mantener README.md sincronizado con la versión activa leída desde VERSION. Consolida además la integración pendiente de Pre-1.0.0.2. Sin cambios de esquema ni migraciones.",
  "summary": "SIVI Pre-1.0.0.3 sincroniza dinámicamente la documentación general con la versión de preproducción.",
  "database_migration_required": false,
  "automatic_migrations": false,
  "functional_scope_changed": false,
  "fresh_install": false,
  "clean_relaunch": false,
  "setup_required": true,
  "next_version": "Pre-1.0.0.4",
  "runtime": {
    "db_host": "CONFIGURABLE_VIA_DB_HOST",
    "containers": [
      "sivi-produccion-app",
      "sivi-produccion-antimalware",
      "sivi-produccion-notificaciones",
      "sivi-produccion-respaldos",
      "sivi-produccion-db"
    ],
    "volumes": [
      "db_data",
      "app_storage",
      "sivi_backups",
      "clamav_signatures"
    ]
  },
  "deployment_topology": {
    "type": "split",
    "application_server": "CONFIGURABLE_VIA_APP_SERVER_HOSTNAME",
    "database_server": "CONFIGURABLE_VIA_DB_SERVER_HOSTNAME",
    "internal_dns": "CONFIGURABLE_VIA_APP_INTERNAL_DNS",
    "application_server_resources": {
      "os": "Oracle Linux 10.1",
      "cpu": 4,
      "ram_gb": 8,
      "disk1_gb": 100,
      "disk2_gb": 100
    },
    "database_server_resources": {
      "os": "Oracle Linux 10.1",
      "cpu": 8,
      "ram_gb": 8,
      "disk1_gb": 100,
      "disk2_gb": 100
    },
    "parameterized_runtime": true
  },
  "soc_hardening": {
    "database_tls": "verify_ca",
    "database_require_secure_transport": true,
    "docker_secrets": true,
    "malware_scanning": true,
    "strict_csp": true,
    "runtime_ddl_removed": true,
    "least_privilege_database": true,
    "encrypted_backups_only": true,
    "structured_security_events": true,
    "sast_pipeline": true,
    "image_cve_scan": true,
    "sbom": true,
    "dast_baseline": true,
    "xlsx_decompression_guard": true,
    "minimal_public_health_endpoints": true,
