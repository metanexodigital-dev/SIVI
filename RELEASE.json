{
  "application": "SIVI",
  "version": "1.0.0.0",
  "stage": "production",
  "production_baseline": "1.0.0.0",
  "required_environment_variable": "APP_VERSION=1.0.0.0",
  "release_date": "2026-08-04",
  "status": "production",
  "name": "Relanzamiento oficial 1.0.0.0 - SOC Ready y experiencia de usuario final",
  "build_id": "SIVI-1.0.0.0",
  "release_notes": "Relanzamiento SIVI 1.0.0.0 para arquitectura Docker APP/DB separada, con hardening SOC y ajustes finales de experiencia de usuario. Se centraliza el guardado automático de borradores; la placa sugerida se integra al campo de Placa RNEC; equipos propios sin placa físicamente visible pueden continuar solo con justificación; 'Otro motivo' permite explicación; las evidencias del módulo de validación se ocultan y dejan de ser requeridas cuando Administración deshabilita imágenes; la sede ya no solicita resultado manual; los cargos se limitan a Registrador, Auxiliar y Técnico; Notificaciones/Correcciones se muestran solo con pendientes y los filtros territoriales se ocultan cuando la sede ya está definida. Sin cambios de esquema ni migraciones.",
  "summary": "SIVI 1.0.0.0 parametrizable para Docker/Dokploy, UX Final y SOC Ready. La documentación de cambios queda consolidada exclusivamente en Actualizaciones.md.",
  "database_migration_required": false,
  "automatic_migrations": false,
  "functional_scope_changed": false,
  "fresh_install": true,
  "clean_relaunch": true,
  "setup_required": true,
  "next_version": "1.0.0.1",
  "runtime": {
    "db_host": "CONFIGURABLE_VIA_DB_HOST",
    "containers": [
      "sivi-produccion-app",
      "sivi-produccion-antimalware",
      "sivi-produccion-notificaciones",
      "sivi-produccion-respaldos",
      "sivi-produccion-db"
    ],
    "volumes": [
      "db_data",
      "app_storage",
      "sivi_backups",
      "clamav_signatures"
    ]
  },
  "deployment_topology": {
    "type": "split",
    "application_server": "CONFIGURABLE_VIA_APP_SERVER_HOSTNAME",
    "database_server": "CONFIGURABLE_VIA_DB_SERVER_HOSTNAME",
    "internal_dns": "CONFIGURABLE_VIA_APP_INTERNAL_DNS",
    "application_server_resources": {
      "os": "Oracle Linux 10.1",
      "cpu": 4,
      "ram_gb": 8,
      "disk1_gb": 100,
      "disk2_gb": 100
    },
    "database_server_resources": {
      "os": "Oracle Linux 10.1",
      "cpu": 8,
      "ram_gb": 8,
      "disk1_gb": 100,
      "disk2_gb": 100
    },
    "parameterized_runtime": true
  },
  "soc_hardening": {
    "database_tls": "verify_ca",
    "database_require_secure_transport": true,
    "docker_secrets": true,
    "malware_scanning": true,
    "strict_csp": true,
    "runtime_ddl_removed": true,
    "least_privilege_database": true,
    "encrypted_backups_only": true,
    "structured_security_events": true,
    "sast_pipeline": true,
    "image_cve_scan": true,
    "sbom": true,
    "dast_baseline": true,
    "xlsx_decompression_guard": true,
    "minimal_public_health_endpoints": true,
    "setup_runtime_ddl": false,
    "legacy_schema_changes_disabled_by_default": true,
    "final_soc_approval_external": true
  },
  "ux_finalization": true,
  "ux_changes": {
    "drafts_admin_controlled": true,
    "suggested_plate_inline": true,
    "own_plate_unavailable_with_reason": true,
    "other_belongs_reason_text": true,
    "validation_images_admin_controlled": true,
    "site_result_automatic": true,
    "responsible_roles": [
      "Registrador",
      "Auxiliar",
      "Técnico"
    ],
    "pending_navigation_only": true,
    "fixed_site_filter_simplified": true
  },
  "documentation": {
    "general": "README.md",
    "updates": "Actualizaciones.md",
    "markdown_policy": "Only README.md and Actualizaciones.md are allowed"
  }
}
